#!/usr/bin/env bash

set -euo pipefail

# Perform regex find-and-replace across multiple files in parallel.
# Uses ripgrep for file discovery (auto-skips binary files, respects .gitignore)
# and perl for replacement (PCRE regex, full perl -pe expression support).

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS] <perl-script> <directories...>

Perform find-and-replace across files in specified directories.
By default modifies files in place.

The perl-script argument is passed directly to 'perl -pe', so the full
perl substitution syntax is available:

  s/pattern/replacement/g        basic replacement
  s/pattern/replacement/gi       case-insensitive
  s/pattern/replacement/ge       evaluate replacement as perl expression
  s/pattern/\$1 * 2/ge           double all numbers
  sub f { ... } s/pat/f(\$&)/ge  define helpers inline

Capture groups are referenced as \$1, \$2, or \$+{name} (named captures).
Use \$& for the full match.

OPTIONS:
    -t, --type TYPE     Filter by file type (can be specified multiple times)
                        Uses ripgrep type names: py, js, rs, md, cpp, sh, etc.
                        Run 'rg --type-list' to see all available types
    -j, --jobs NUM      Max number of parallel jobs (default: nproc)
    -b, --backup EXT    Create backup files with specified extension (e.g., .bak, .orig)
    -d, --dry-run       Show changes without modifying files
    -h, --help          Show this help message

ARGUMENTS:
    perl-script         A perl -pe expression (quoted to protect from shell)
    directories         One or more directories to search

EXAMPLES:
    # Rename a symbol in Python files
    $(basename "$0") -t py 's/old_name/new_name/g' src/

    # Word boundary — avoids partial matches
    $(basename "$0") 's/\bold_name\b/new_name/g' src/

    # Case-insensitive
    $(basename "$0") 's/\bcolour\b/color/gi' src/

    # Capture group — rename issue prefix
    $(basename "$0") 's/ISL-(\d+)/PROJ-\$1/g' .

    # Named capture
    $(basename "$0") 's/(?<id>\d+)/ID_\$+{id}/g' .

    # Evaluate replacement as perl expression (double all integers)
    $(basename "$0") 's/\b(\d+)\b/\$1 * 2/ge' src/

    # Case-preserving substitution with helper sub
    $(basename "$0") 'sub fc { \$_[0] eq uc \$_[0] ? uc \$_[1] : \$_[0] eq ucfirst lc \$_[0] ? ucfirst \$_[1] : \$_[1] } s/\bcolour\b/fc(\$&, "color")/gie' src/

    # Dry-run: show what would change
    $(basename "$0") -d 's/foo/bar/g' src/

    # Multiple file types
    $(basename "$0") -t cpp -t hpp 's/OldClass/NewClass/g' src/

    # With backup files
    $(basename "$0") -b .bak 's/old/new/g' ./

    # Limit to 4 parallel jobs
    $(basename "$0") -j 4 's/foo/bar/g' src/

EOF
    exit 0
}

# Parse arguments
types=()
dry_run=0
parallel_jobs=""
backup_ext=""

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            usage
            ;;
        -t|--type)
            if [[ -z "${2:-}" ]]; then
                printf "Error: -t/--type requires an argument\n" >&2
                exit 1
            fi
            types+=("$2")
            shift 2
            ;;
        -j|--jobs)
            if [[ -z "${2:-}" ]]; then
                printf "Error: -j/--jobs requires an argument\n" >&2
                exit 1
            fi
            if ! [[ "$2" =~ ^[1-9][0-9]*$ ]]; then
                printf "Error: -j/--jobs must be a positive integer\n" >&2
                exit 1
            fi
            parallel_jobs="$2"
            shift 2
            ;;
        -b|--backup)
            if [[ -z "${2:-}" ]]; then
                printf "Error: -b/--backup requires an argument\n" >&2
                exit 1
            fi
            backup_ext="$2"
            shift 2
            ;;
        -d|--dry-run)
            dry_run=1
            shift
            ;;
        -*)
            printf "Error: Unknown option: %s\n" "$1" >&2
            printf "Use -h or --help for usage information\n" >&2
            exit 1
            ;;
        *)
            break
            ;;
    esac
done

# Check for required arguments
if [[ $# -lt 2 ]]; then
    printf "Error: Missing required arguments\n" >&2
    printf "Use -h or --help for usage information\n" >&2
    exit 1
fi

perl_script="$1"
shift
directories=("$@")

# Validate directories
for dir in "${directories[@]}"; do
    if [[ ! -d "$dir" ]]; then
        printf "Error: Directory not found: %s\n" "$dir" >&2
        exit 1
    fi
done

# Build ripgrep file-discovery command
rg_cmd=(rg --files)
for type in "${types[@]}"; do
    rg_cmd+=(-t "$type")
done
rg_cmd+=("${directories[@]}")

# Default parallelism
if [[ -z "$parallel_jobs" ]]; then
    parallel_jobs=$(nproc)
fi

# Process a single file.
process_file() {
    local file="$1"

    if [[ "$dry_run" -eq 1 ]]; then
        # Run perl in read-only mode and diff against original.
        # diff output goes to stdout so it can be piped into patch(1).
        # Informational messages go to stderr to avoid corrupting the diff stream.
        local transformed diff_out rel_file output
        transformed=$(perl -pe "$perl_script" -- "$file" 2>/dev/null) || {
            printf "Warning: Failed to process %s\n" "$file" >&2
            return 1
        }
        if [[ "$transformed" != "$(cat "$file")" ]]; then
            rel_file=$(realpath --relative-to="$PWD" "$file")
            printf "Would modify: %s\n" "$rel_file" >&2
            diff_out=$(diff -u "$file" - <<< "$transformed" || true)
            output=$(printf '%s\n' "$diff_out" \
                | sed -e "s|^--- .*|--- ${rel_file}|" \
                      -e "s|^+++ .*|+++ ${rel_file}|")
            printf '%s\n\n' "$output"
        fi
    else
        if [[ -n "$backup_ext" ]]; then
            cp "$file" "${file}${backup_ext}" 2>/dev/null || {
                printf "Warning: Failed to create backup for %s\n" "$file" >&2
                return 1
            }
        fi
        perl -i -pe "$perl_script" -- "$file" 2>/dev/null || {
            printf "Warning: Failed to process %s\n" "$file" >&2
            return 1
        }
    fi
}

export -f process_file
export perl_script dry_run backup_ext

if [[ "$dry_run" -eq 1 ]]; then
    printf "Running in DRY-RUN mode - no files will be modified\n" >&2
    printf "Remove -d or --dry-run to apply changes\n" >&2
    # Dry-run is serial: coherent stdout is more important than speed.
    while IFS= read -r file; do
        process_file "$file"
    done < <("${rg_cmd[@]}")
else
    # In-place: dispatch jobs as filenames arrive from rg.
    running=0
    while IFS= read -r file; do
        process_file "$file" &
        running=$(( running + 1 ))

        # Throttle: when the pool is full, wait for any one job to finish.
        if [[ "$running" -ge "$parallel_jobs" ]]; then
            wait -n || true
            running=$(( running - 1 ))
        fi
    done < <("${rg_cmd[@]}")

    # Drain remaining jobs.
    wait
fi
