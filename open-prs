#!/usr/bin/env bash

# Script to display all open PRs organized by repository

set -euo pipefail

# Parse JSON and organize by repo and host
declare -A repos
pr_count=0

# Collect all hosts configured in gh
mapfile -t hosts < <(gh auth status 2>&1 | awk '/^[^ ]/{host=$1} /Active account: true/{print host}' || true)

if [ "${#hosts[@]}" -eq 0 ]; then
  printf "No authenticated gh hosts found.\n"
  exit 1
fi

graphql_query='
  query {
    search(query: "is:pr is:open author:@me", type: ISSUE, first: 100) {
      nodes {
        ... on PullRequest {
          number
          title
          url
          headRefName
          baseRefName
          repository { nameWithOwner }
        }
      }
    }
  }
'

# Fetch PRs from all hosts and combine results
prs="[]"
for host in "${hosts[@]}"; do
  host_prs=$(gh api graphql --hostname "$host" -f query="$graphql_query" \
    --jq '.data.search.nodes' 2>/dev/null || true)
  if [ -n "$host_prs" ] && [ "$host_prs" != "[]" ] && [ "$host_prs" != "null" ]; then
    prs=$(jq -s '.[0] + .[1]' <(printf '%s' "$prs") <(printf '%s' "$host_prs"))
  fi
done

if [ -z "$prs" ] || [ "$prs" = "[]" ]; then
  printf "No open PRs found.\n"
  exit 0
fi

while IFS= read -r line; do
  repo=$(printf '%s\n' "$line" | jq -r '.repository.nameWithOwner')
  number=$(printf '%s\n' "$line" | jq -r '.number')
  title=$(printf '%s\n' "$line" | jq -r '.title')
  url=$(printf '%s\n' "$line" | jq -r '.url')
  head=$(printf '%s\n' "$line" | jq -r '.headRefName')
  base=$(printf '%s\n' "$line" | jq -r '.baseRefName')
  
  # Extract hostname from URL
  hostname=$(printf '%s\n' "$url" | sed -E 's|https?://([^/]+)/.*|\1|')
  
  # Use hostname+repo as key to separate by host
  key="$hostname|$repo"
  if [ -z "${repos[$key]:-}" ]; then
    repos[$key]=""
  fi
  if [ -n "${repos[$key]}" ]; then
    repos[$key]+=$'\n'
  fi
  repos[$key]+=$(printf '  #%-4d %s\n           %s → %s\n           %s' "$number" "$title" "$head" "$base" "$url")
  pr_count=$((pr_count + 1))
done < <(printf '%s\n' "$prs" | jq -c '.[]')

# Check if we have any PRs
if [ "$pr_count" -eq 0 ]; then
  printf "No open PRs found.\n"
  exit 0
fi

# Display organized output
printf "Your Open Pull Requests\n"
printf "=======================\n\n"

for key in $(printf '%s\n' "${!repos[@]}" | sort); do
  hostname=$(printf '%s\n' "$key" | cut -d'|' -f1)
  repo=$(printf '%s\n' "$key" | cut -d'|' -f2)
  printf "\n%s (%s)\n" "$repo" "$hostname"
  printf "%s\n" "$(printf '%0.s-' $(seq 1 $((${#repo} + ${#hostname} + 3))))"
  printf "%s\n" "${repos[$key]}"
done
