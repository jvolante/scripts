    # Doubled-l British forms  →  single-l American forms
    '(?i)\bcancelled\b'         'canceled'
    '(?i)\bcancelling\b'        'canceling'
    '(?i)\bcancellation\b'      'cancelation'
    '(?i)\bcancellations\b'     'cancelations'
    '(?i)\bcounselled\b'        'counseled'
    '(?i)\bcounselling\b'       'counseling'
    '(?i)\bcounsellor\b'        'counselor'
    '(?i)\bcounsellors\b'       'counselors'
    '(?i)\benrolment\b'         'enrollment'
