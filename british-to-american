    '(?i)\bsignalled\b'         'signaled'
    '(?i)\bsignalling\b'        'signaling'
    '(?i)\btravelled\b'         'traveled'
    '(?i)\btravelling\b'        'traveling'
    '(?i)\btraveller\b'         'traveler'
    '(?i)\btravellers\b'        'travelers'
    '(?i)\bwilful\b'            'willful'
    '(?i)\bwilfully\b'          'willfully'

    # -ogue  →  -og
    '(?i)\bcatalogue\b'         'catalog'
    '(?i)\bcatalogues\b'        'catalogs'
