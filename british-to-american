#!/usr/bin/env bash

set -euo pipefail

# Convert common British English spellings to Standard American English across
# files in a directory tree.  Uses ripgrep for file discovery and perl for
# case-preserving in-place substitution.
#
# Replacements preserve the case of the original word:
#   colour  → color
#   Colour  → Color
#   COLOUR  → COLOR
#
# Usage:
#   british-to-american [OPTIONS] <directories...>
#
# Examples:
#   british-to-american src/                   # apply in-place
#   british-to-american -d src/                # dry-run (no modifications)
#   british-to-american -j 4 -t py src/ lib/   # 4 jobs, Python files only
#   british-to-american -b .bak src/           # backup before modifying

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS] <directories...>

Replaces common British English spellings with American English equivalents
across all text files in the given directories.  Replacements preserve the
original word's case (lowercase, Title-case, or ALLCAPS).

OPTIONS:
    -d, --dry-run       Show changes without modifying files
    -j, --jobs NUM      Max parallel jobs (default: nproc)
    -b, --backup EXT    Create backup files (e.g. -b .bak)
    -t, --type TYPE     Restrict to a ripgrep file type (repeatable)
    -h, --help          Show this help message

EXAMPLES:
    $(basename "$0") src/
    $(basename "$0") -d src/
    $(basename "$0") -j 4 -t py src/ lib/
    $(basename "$0") -b .bak .
EOF
    exit 0
}

