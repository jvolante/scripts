# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------
types=()
dry_run=0
parallel_jobs=""
backup_ext=""
directories=()

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            usage
            ;;
        -j|--jobs)
            if [[ -z "${2:-}" ]]; then
                printf "Error: %s requires an argument\n" "$1" >&2
                exit 1
            fi
            parallel_jobs="$2"
            shift 2
            ;;
        -b|--backup)
            if [[ -z "${2:-}" ]]; then
                printf "Error: %s requires an argument\n" "$1" >&2
                exit 1
            fi
            backup_ext="$2"
            shift 2
            ;;
        -t|--type)
            if [[ -z "${2:-}" ]]; then
                printf "Error: %s requires an argument\n" "$1" >&2
                exit 1
            fi
            types+=("$2")
            shift 2
            ;;
        -d|--dry-run)
            dry_run=1
            shift
            ;;
        -*)
            printf "Error: Unknown option: %s\n" "$1" >&2
            printf "Use -h or --help for usage information\n" >&2
            exit 1
            ;;
        *)
            directories+=("$1")
            shift
            ;;
    esac
done

if [[ ${#directories[@]} -eq 0 ]]; then
    printf "Error: at least one directory argument is required\n" >&2
    printf "Use -h or --help for usage information\n" >&2
    exit 1
fi

# Validate directories up front so we fail fast before running any replacements.
for dir in "${directories[@]}"; do
    if [[ ! -d "$dir" ]]; then
        printf "Error: Directory not found: %s\n" "$dir" >&2
        exit 1
    fi
done

# ---------------------------------------------------------------------------
# Build a single perl inline script from the SUBSTITUTIONS table.
#
# Each pair (pattern, replacement) becomes one substitution statement:
#   s/\bpattern\b/fix_case($&, "replacement")/gi
#
# fix_case() preserves the case of the matched word:
#   - ALL-CAPS match  → ALL-CAPS replacement
#   - Title-case match → Title-case replacement
#   - lowercase match  → lowercase replacement  (default)
# ---------------------------------------------------------------------------
assert_even_substitutions() {
    local count=${#SUBSTITUTIONS[@]}
    if (( count % 2 != 0 )); then
        printf "Internal error: SUBSTITUTIONS table has odd length (%d)\n" "$count" >&2
        exit 2
    fi
}
assert_even_substitutions

build_perl_script() {
    # shellcheck disable=SC2016  # Single quotes intentional: $ tokens are perl, not shell
    printf 'sub fix_case {\n'
    # shellcheck disable=SC2016
    printf '    my ($matched, $rep) = @_;\n'
    # shellcheck disable=SC2016
    printf '    return uc($rep)     if $matched eq uc($matched);\n'
    # shellcheck disable=SC2016
    printf '    return ucfirst($rep) if length($matched) > 1\n'
    # shellcheck disable=SC2016
    printf '        && substr($matched, 0, 1) eq uc(substr($matched, 0, 1))\n'
    # shellcheck disable=SC2016
    printf '        && substr($matched, 1)    eq lc(substr($matched, 1));\n'
    # shellcheck disable=SC2016
    printf '    return $rep;\n'
    printf '}\n'
    for (( i = 0; i < ${#SUBSTITUTIONS[@]}; i += 2 )); do
        local pat="${SUBSTITUTIONS[$i]}"
        local rep="${SUBSTITUTIONS[$((i + 1))]}"
        # Escape any double-quotes or backslashes in the replacement string so
        # it is safe to embed inside a double-quoted Perl string literal.
        local rep_escaped="${rep//\\/\\\\}"
        rep_escaped="${rep_escaped//\"/\\\"}"
        printf 's/%s/fix_case($&, "%s")/gie;\n' "$pat" "$rep_escaped"
    done
}

PERL_SCRIPT="$(build_perl_script)"
readonly PERL_SCRIPT

# Build ripgrep file-discovery command.
rg_cmd=(rg --files)
for t in "${types[@]}"; do
    rg_cmd+=(-t "$t")
done
rg_cmd+=("${directories[@]}")

if [[ -z "$parallel_jobs" ]]; then
    parallel_jobs=$(nproc)
fi

total=$(( ${#SUBSTITUTIONS[@]} / 2 ))
printf "Applying %d British→American substitution rules...\n" "$total" >&2

# ---------------------------------------------------------------------------
# Process a single file: apply all substitutions in one perl pass.
# ---------------------------------------------------------------------------
process_file() {
    local file="$1"

    if [[ "$dry_run" -eq 1 ]]; then
        local transformed rel_file diff_out output
        transformed=$(perl -pe "$PERL_SCRIPT" -- "$file" 2>/dev/null) || {
            printf "Warning: Failed to process %s\n" "$file" >&2
            return 1
        }
        if [[ "$transformed" != "$(cat "$file")" ]]; then
            rel_file=$(realpath --relative-to="$PWD" "$file")
            printf "Would modify: %s\n" "$rel_file" >&2
            diff_out=$(diff -u "$file" - <<< "$transformed" || true)
            output=$(printf '%s\n' "$diff_out" \
                | sed -e "s|^--- .*|--- ${rel_file}|" \
                      -e "s|^+++ .*|+++ ${rel_file}|")
            printf '%s\n\n' "$output"
        fi
    else
        if [[ -n "$backup_ext" ]]; then
            cp "$file" "${file}${backup_ext}" 2>/dev/null || {
                printf "Warning: Failed to create backup for %s\n" "$file" >&2
                return 1
            }
        fi
        perl -i -pe "$PERL_SCRIPT" -- "$file" 2>/dev/null || {
            printf "Warning: Failed to process %s\n" "$file" >&2
            return 1
        }
    fi
}

export -f process_file
export PERL_SCRIPT dry_run backup_ext

if [[ "$dry_run" -eq 1 ]]; then
    printf "Running in DRY-RUN mode - no files will be modified\n" >&2
    printf "Remove -d or --dry-run to apply changes\n" >&2
    while IFS= read -r file; do
        process_file "$file"
    done < <("${rg_cmd[@]}")
else
    running=0
    while IFS= read -r file; do
        process_file "$file" &
        running=$(( running + 1 ))
        if [[ "$running" -ge "$parallel_jobs" ]]; then
            wait -n || true
            running=$(( running - 1 ))
        fi
    done < <("${rg_cmd[@]}")
    wait
fi

printf "Done.\n" >&2
