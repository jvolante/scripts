    '(?i)\blevelling\b'         'leveling'
    '(?i)\bmodelled\b'          'modeled'
    '(?i)\bmodelling\b'         'modeling'
    '(?i)\bmodeller\b'          'modeler'
    '(?i)\bmodellers\b'         'modelers'
    '(?i)\bravelled\b'          'raveled'
