    '(?i)\bhaemoglobin\b'       'hemoglobin'
    '(?i)\bhaemorrhage\b'       'hemorrhage'
    '(?i)\bhaemorrhages\b'      'hemorrhages'
    '(?i)\bhomologue\b'         'homolog'
    '(?i)\bhomologues\b'        'homologs'
    '(?i)\binstalment\b'        'installment'
    '(?i)\binstalments\b'       'installments'
    '(?i)\bleukaemia\b'         'leukemia'
    '(?i)\blicence\b'           'license'
    '(?i)\blicences\b'          'licenses'
    '(?i)\bmanoeuvre\b'         'maneuver'
    '(?i)\bmanoeuvres\b'        'maneuvers'
    '(?i)\bmanoeuvred\b'        'maneuvered'
    '(?i)\bmanoeuvring\b'       'maneuvering'
    '(?i)\bmould\b'             'mold'
    '(?i)\bmoulds\b'            'molds'
    '(?i)\bmoulded\b'           'molded'
    '(?i)\bmoulding\b'          'molding'
    '(?i)\bmouldy\b'            'moldy'
    '(?i)\bmoult\b'             'molt'
    '(?i)\bmoults\b'            'molts'
