#!/usr/bin/env bash

set -euo pipefail

# Convert common British English spellings to Standard American English across
# files in a directory tree.  All arguments are passed through to replace-in-files
# before the mandatory <pattern> <replacement> <directories...> positional args,
# so flags like -d (dry-run), -j (jobs), -b (backup), and -t (file type) all work.
#
# Usage:
#   british-to-american [REPLACE-IN-FILES OPTIONS] <directories...>
#
# Examples:
#   british-to-american src/                   # apply in-place
#   british-to-american -d src/                # dry-run (no modifications)
#   british-to-american -j 4 -t py src/ lib/   # 4 jobs, Python files only
#   british-to-american -b .bak src/           # backup before modifying

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly REPLACE="${SCRIPT_DIR}/replace-in-files"

if [[ ! -x "$REPLACE" ]]; then
    printf "Error: replace-in-files not found or not executable at %s\n" "$REPLACE" >&2
    exit 1
fi

usage() {
    cat <<EOF
Usage: $(basename "$0") [REPLACE-IN-FILES OPTIONS] <directories...>

Replaces common British English spellings with American English equivalents
across all text files in the given directories.

All OPTIONS are forwarded verbatim to replace-in-files:
    -d, --dry-run       Show changes without modifying files
    -j, --jobs NUM      Max parallel jobs (default: nproc)
    -b, --backup EXT    Create backup files (e.g. -b .bak)
    -t, --type TYPE     Restrict to a ripgrep file type (repeatable)
    -h, --help          Show this help message

EXAMPLES:
    $(basename "$0") src/
    $(basename "$0") -d src/
    $(basename "$0") -j 4 -t py src/ lib/
    $(basename "$0") -b .bak .
EOF
    exit 0
}

# ---------------------------------------------------------------------------
# Substitution table: (pattern, replacement) pairs.
# Patterns use \b word-boundaries to avoid partial-word matches (e.g. "colour"
# inside "discoloured" would still match — intentionally, since the suffix
# itself carries the British spelling).  Case-insensitive flag (?i) is used so
# that COLOUR, Colour, and colour are all handled; the replacement preserves
# the lower-case American form and the pattern's capture group restores leading
# capitalisation where needed.
#
# Format: alternating entries — even indices are patterns, odd are replacements.
#
# NOTE: ${1} tokens in the replacement strings are Rust regex back-references
# consumed by `sd` — they are intentionally single-quoted to prevent the shell
# from expanding them.
# shellcheck disable=SC2016
# ---------------------------------------------------------------------------
declare -a SUBSTITUTIONS=(
