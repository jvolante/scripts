# ---------------------------------------------------------------------------
# Argument parsing: collect replace-in-files flags (everything before the
# first non-flag argument) and the trailing directory list.
# ---------------------------------------------------------------------------
passthrough_args=()
directories=()

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            usage
            ;;
        # Flags that consume the next token
        -j|--jobs|-b|--backup|-t|--type)
            if [[ -z "${2:-}" ]]; then
                printf "Error: %s requires an argument\n" "$1" >&2
                exit 1
            fi
            passthrough_args+=("$1" "$2")
            shift 2
            ;;
        # Boolean flags
        -d|--dry-run)
            passthrough_args+=("$1")
            shift
            ;;
        -*)
            printf "Error: Unknown option: %s\n" "$1" >&2
            printf "Use -h or --help for usage information\n" >&2
            exit 1
            ;;
        *)
            directories+=("$1")
            shift
            ;;
    esac
done

if [[ ${#directories[@]} -eq 0 ]]; then
    printf "Error: at least one directory argument is required\n" >&2
    printf "Use -h or --help for usage information\n" >&2
    exit 1
fi

# Validate directories up front so we fail fast before running any replacements.
for dir in "${directories[@]}"; do
    if [[ ! -d "$dir" ]]; then
        printf "Error: Directory not found: %s\n" "$dir" >&2
        exit 1
    fi
done

# ---------------------------------------------------------------------------
# Run each substitution pair.
# ---------------------------------------------------------------------------
assert_even_substitutions() {
    local count=${#SUBSTITUTIONS[@]}
    if (( count % 2 != 0 )); then
        printf "Internal error: SUBSTITUTIONS table has odd length (%d)\n" "$count" >&2
        exit 2
    fi
}
assert_even_substitutions

total=$(( ${#SUBSTITUTIONS[@]} / 2 ))
printf "Applying %d British→American substitution rules...\n" "$total" >&2

# Determine whether we are in dry-run mode so we can emit one banner instead
# of one per rule.
is_dry_run=0
for arg in "${passthrough_args[@]}"; do
    if [[ "$arg" == "-d" || "$arg" == "--dry-run" ]]; then
        is_dry_run=1
        break
    fi
done

if [[ "$is_dry_run" -eq 1 ]]; then
    printf "Running in DRY-RUN mode - no files will be modified\n" >&2
    printf "Remove -d or --dry-run to apply changes\n" >&2
fi

for (( i = 0; i < ${#SUBSTITUTIONS[@]}; i += 2 )); do
    pattern="${SUBSTITUTIONS[$i]}"
    replacement="${SUBSTITUTIONS[$((i + 1))]}"
    # Filter stderr: suppress the per-invocation dry-run banner lines emitted
    # by replace-in-files but keep any Warning: lines so nothing real is lost.
    "$REPLACE" "${passthrough_args[@]}" "$pattern" "$replacement" "${directories[@]}" \
        2> >(grep -v '^\(Running in DRY-RUN mode\|Remove -d\)' >&2 || true)
done

printf "Done.\n" >&2
