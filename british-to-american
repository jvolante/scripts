    '(?i)\bfavourites\b'        'favorites'
    '(?i)\bfoetus\b'            'fetus'
    '(?i)\bgaol\b'              'jail'
    '(?i)\bgrey\b'              'gray'
    '(?i)\bgreys\b'             'grays'
    '(?i)\bgreyed\b'            'grayed'
    '(?i)\bgreying\b'           'graying'
