    '(?i)\bflavouring\b'        'flavoring'
    '(?i)\bflavourful\b'        'flavorful'
    '(?i)\bhonour\b'            'honor'
    '(?i)\bhonours\b'           'honors'
    '(?i)\bhonoured\b'          'honored'
    '(?i)\bhonorable\b'         'honorable'
    '(?i)\bhumour\b'            'humor'
    '(?i)\bhumours\b'           'humors'
    '(?i)\bhumoured\b'          'humored'
