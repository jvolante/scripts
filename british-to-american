    '(?i)\bneighbourhoods\b'    'neighborhoods'
    '(?i)\bneighbouring\b'      'neighboring'
    '(?i)\brumour\b'            'rumor'
    '(?i)\brumours\b'           'rumors'
    '(?i)\brumoured\b'          'rumored'
    '(?i)\bvalour\b'            'valor'
    '(?i)\bvigour\b'            'vigor'

    # -ise  →  -ize  (verb forms; ${1} tokens are Rust regex back-references for sd)
    '(?i)\b(\w+)ise\b'          '${1}ize'
    '(?i)\b(\w+)ised\b'         '${1}ized'
    '(?i)\b(\w+)ises\b'         '${1}izes'
